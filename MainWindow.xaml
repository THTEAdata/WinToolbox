<Window x:Class="WinToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinToolbox · 电脑工具箱"
        Width="1400" Height="880" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="BlobATransform" Storyboard.TargetProperty="X"
                                     From="-40" To="140" Duration="0:0:26">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="BlobATransform" Storyboard.TargetProperty="Y"
                                     From="-30" To="90" Duration="0:0:31">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="BlobBTransform" Storyboard.TargetProperty="X"
                                     From="60" To="-160" Duration="0:0:34">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="BlobBTransform" Storyboard.TargetProperty="Y"
                                     From="40" To="-120" Duration="0:0:29">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="BlobCTransform" Storyboard.TargetProperty="X"
                                     From="-60" To="110" Duration="0:0:38">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="BlobCTransform" Storyboard.TargetProperty="Y"
                                     From="30" To="-90" Duration="0:0:24">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid ClipToBounds="True">

        <!-- ================= 背景：底色 + 流动色斑 ================= -->
        <Grid Background="{DynamicResource BgGradient}" ClipToBounds="True">
            <Canvas ClipToBounds="True">
                <Ellipse Width="980" Height="980" Canvas.Left="-320" Canvas.Top="-420"
                         Fill="{DynamicResource Blob1Brush}" Opacity="0.75">
                    <Ellipse.OpacityMask>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.OpacityMask>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="BlobATransform" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse Width="820" Height="820" Canvas.Left="780" Canvas.Top="-260"
                         Fill="{DynamicResource Blob2Brush}" Opacity="0.7">
                    <Ellipse.OpacityMask>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.OpacityMask>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="BlobBTransform" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse Width="760" Height="760" Canvas.Left="420" Canvas.Top="520"
                         Fill="{DynamicResource Blob3Brush}" Opacity="0.6">
                    <Ellipse.OpacityMask>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.OpacityMask>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="BlobCTransform" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- ================= 主体布局 ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧窄导航栏 -->
            <Border Grid.Column="0" Background="{DynamicResource RailBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 品牌 -->
                    <StackPanel Grid.Row="0" Margin="0,20,0,14" HorizontalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0A6BD6" Offset="0" />
                                    <GradientStop Color="#FF2FB3D6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M10,5 L26,5 L26,17 L10,17 Z M13,22 L23,22 M18,17 L18,22"
                                  Stroke="White" StrokeThickness="1.8" Width="20" Height="18" Stretch="Uniform"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- 导航 -->
                    <ListBox x:Name="Nav" Grid.Row="1" Style="{StaticResource RailList}"
                             SelectionChanged="Nav_SelectionChanged">
                        <ListBoxItem Tag="dashboard">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Data="M3,3 L10,3 L10,10 L3,10 Z M13,3 L20,3 L20,10 L13,10 Z M3,13 L10,13 L10,20 L3,20 Z M13,13 L20,13 L20,20 L13,20 Z" />
                                <TextBlock Text="概览" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="sys">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Data="M2,4 L22,4 L22,16 L2,16 Z M8,20 L16,20 M12,16 L12,20" />
                                <TextBlock Text="系统" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="clean">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Data="M4,6 L20,6 M9,6 L9,20 L15,20 L15,6 M6,6 L7,3 L17,3 L18,6 M10,9 L10,17 M14,9 L14,17" />
                                <TextBlock Text="清理" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="process">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Data="M4,20 L4,13 M9.5,20 L9.5,8 M15,20 L15,11 M20.5,20 L20.5,4" />
                                <TextBlock Text="进程" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="service">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Data="M3,4 L21,4 L21,9 L3,9 Z M3,13 L21,13 L21,18 L3,18 Z M6.5,6.5 L6.6,6.5 M6.5,15.5 L6.6,15.5" />
                                <TextBlock Text="服务" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="network">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Data="M12,2 A10,10 0 1 1 11.99,2 M2,12 L22,12 M12,2 C7,7 7,17 12,22 M12,2 C17,7 17,17 12,22" />
                                <TextBlock Text="网络" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="usb">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Data="M9,3 L15,3 L15,8 L9,8 Z M11,8 L11,14 L13,14 L13,8 M12,14 L12,20 M9,20 L15,20 M5,5 L5,7 M5,7 A1,1 0 1 1 4.99,7" />
                                <TextBlock Text="USB" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="battery">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Data="M3,8 L17,8 L17,18 L3,18 Z M19,11 L21,11 L21,15 L19,15 Z M6,10 L6,16 L9,16 L9,10 Z" />
                                <TextBlock Text="电量" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="settings">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Width="19" Height="19" Stretch="Uniform" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Data="M3,6 L21,6 M3,12 L21,12 M3,18 L21,18 M7,3 L7,9 M15,9 L15,15 M10,15 L10,21" />
                                <TextBlock Text="设置" FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- 底部权限 -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <Ellipse x:Name="AdminDot" Width="8" Height="8" Fill="{DynamicResource WarnBrush}"
                                 HorizontalAlignment="Center" />
                        <TextBlock x:Name="AdminLabel" Text="普通权限" FontSize="10" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextMuteBrush}" />
                        <Button x:Name="ElevateBtn" Content="提权" Style="{StaticResource BtnGhost}"
                                FontSize="11" Padding="8,3" Margin="0,6,0,0" Click="ElevateBtn_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 页头 -->
                <Grid Grid.Row="0" Margin="30,20,24,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="概览" Style="{StaticResource H1}" />
                        <TextBlock x:Name="PageSubtitle" Text="全部模块与实时状态" Style="{StaticResource Caption}"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- 主题快捷切换 -->
                        <Border CornerRadius="16" Background="{DynamicResource CardGlassBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ThemeLightBtn" Content="浅" Style="{StaticResource SegBtn}"
                                        Click="ThemeLight_Click" ToolTip="浅色主题" />
                                <Button x:Name="ThemeDarkBtn" Content="深" Style="{StaticResource SegBtn}"
                                        Click="ThemeDark_Click" ToolTip="深色主题" />
                                <Button x:Name="ThemeSystemBtn" Content="自动" Style="{StaticResource SegBtn}"
                                        Click="ThemeSystem_Click" ToolTip="跟随系统" />
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="16" Padding="11,6" Margin="10,0,0,0"
                                Background="{DynamicResource CardGlassBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="HeaderDot" Width="7" Height="7" Fill="{DynamicResource WarnBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="HeaderStatus" Text="普通权限" Margin="7,0,0,0" FontSize="11.5"
                                           Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ClockText" Text="" Margin="14,0,2,0" FontSize="11.5"
                                   Foreground="{DynamicResource TextMuteBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 页面宿主 -->
                <ContentControl x:Name="PageHost" Grid.Row="1" Margin="30,4,24,10" />

                <!-- 状态栏 -->
                <Grid Grid.Row="2" Margin="30,0,24,0" Height="32">
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuteBrush}" />
                    <TextBlock x:Name="MemoryText" Text="" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextMuteBrush}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
