<UserControl x:Class="WinToolbox.Views.ServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="搜索" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Width="220" Height="34"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock Text="启动类型" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Margin="16,0,8,0" />
                <ComboBox x:Name="StartModeBox" Width="96">
                    <ComboBoxItem Content="自动" Tag="auto" />
                    <ComboBoxItem Content="手动" Tag="demand" />
                    <ComboBoxItem Content="禁用" Tag="disabled" />
                </ComboBox>
                <Button Content="应用" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="ApplyStartMode_Click" />
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="80" Height="3" Margin="14,0,0,0"
                             VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="服务管理器" Style="{StaticResource BtnGhost}" Click="OpenServicesMsc_Click" />
                <Button Content="刷新" Style="{StaticResource Btn}" Margin="4,0,8,0" Click="Refresh_Click" />
                <Button Content="启动" Style="{StaticResource Btn}" Click="Start_Click" />
                <Button Content="停止" Style="{StaticResource BtnDanger}" Margin="6,0" Click="Stop_Click" />
                <Button Content="重启" Style="{StaticResource Btn}" Click="Restart_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <DataGrid x:Name="ServiceGrid" Style="{StaticResource Grid}" RowStyle="{StaticResource GridRow}"
                      SelectionChanged="ServiceGrid_SelectionChanged" MouseDoubleClick="ServiceGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="服务名称" Binding="{Binding Name}" Width="190" SortMemberPath="Name" />
                    <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName}" Width="260" SortMemberPath="DisplayName" />
                    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="88" SortMemberPath="State" />
                    <DataGridTextColumn Header="启动类型" Binding="{Binding StartModeText}" Width="92" SortMemberPath="StartMode" />
                    <DataGridTextColumn Header="登录身份" Binding="{Binding Account}" Width="170" SortMemberPath="Account" />
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" SortMemberPath="ProcessId">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="2,10,2,0">
            <TextBlock x:Name="FooterText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
