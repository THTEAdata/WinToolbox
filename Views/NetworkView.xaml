<UserControl x:Class="WinToolbox.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="392" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左：工具 ============ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- 本机网络 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="本机网络" Style="{StaticResource H2}" />
                            <Button Content="刷新" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right"
                                    Padding="6,2" FontSize="11.5" Click="RefreshAdapters_Click" />
                        </DockPanel>
                        <StackPanel x:Name="AdapterPanel" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- 连通性测试 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="连通性测试" Style="{StaticResource H2}" />

                        <TextBlock Text="主机 / 域名" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                        <TextBox x:Name="HostBox" Style="{StaticResource Input}" Height="34" Text="www.baidu.com" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="端口" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                <TextBox x:Name="PortBox" Style="{StaticResource Input}" Height="34" Text="443" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <Button Content="HTTP" Style="{StaticResource Btn}" Height="34" Click="Http_Click" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Ping 测试" Style="{StaticResource BtnPrimary}" Margin="0,0,8,8"
                                    Click="Ping_Click" />
                            <Button Content="DNS 解析" Style="{StaticResource Btn}" Margin="0,0,8,8" Click="Dns_Click" />
                            <Button Content="TCP 端口" Style="{StaticResource Btn}" Margin="0,0,8,8" Click="Port_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 路由追踪 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="路由追踪" Style="{StaticResource H2}" />
                        <TextBlock Text="逐跳显示数据包到达目标经过的路由器（最多 20 跳，不做反向解析）"
                                   Style="{StaticResource Caption}" Margin="0,6,0,10" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="开始追踪" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Tracert_Click" />
                            <Button Content="停止" Style="{StaticResource BtnGhost}" Click="Stop_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 常用命令 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="常用命令" Style="{StaticResource H2}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="ipconfig /all" Style="{StaticResource BtnGhost}" Margin="0,0,8,8"
                                    Click="Ipconfig_Click" />
                            <Button Content="netstat -ano" Style="{StaticResource BtnGhost}" Margin="0,0,8,8"
                                    Click="Netstat_Click" />
                            <Button Content="arp -a" Style="{StaticResource BtnGhost}" Margin="0,0,8,8"
                                    Click="Arp_Click" />
                            <Button Content="刷新 DNS" Style="{StaticResource BtnGhost}" Margin="0,0,8,8"
                                    Click="FlushDns_Click" />
                            <Button Content="网络连接" Style="{StaticResource BtnGhost}" Margin="0,0,8,8"
                                    Click="OpenAdapters_Click" />
                            <Button Content="网络设置" Style="{StaticResource BtnGhost}" Margin="0,0,8,8"
                                    Click="OpenSettings_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 右：输出控制台 ============ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12,12,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="输出" Style="{StaticResource H2}" />
                        <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="80" Height="4" Margin="12,0,0,0"
                                     VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="复制" Style="{StaticResource BtnGhost}" Click="CopyOutput_Click" />
                        <Button Content="清空" Style="{StaticResource BtnGhost}" Click="ClearOutput_Click" />
                        <Button Content="停止" Style="{StaticResource BtnGhost}" Click="Stop_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#FFF8FAFD" CornerRadius="0,0,12,12" Padding="14,4,8,10">
                    <TextBox x:Name="OutputBox" Style="{StaticResource ConsoleBox}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
