<Window x:Class="WinToolbox.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="380"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="Root" Background="{DynamicResource CardGlassBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
            CornerRadius="16" Padding="18,16" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource DangerSurfaceBrush}"
                    VerticalAlignment="Top">
                <Path Data="M3,8 L17,8 L17,18 L3,18 Z M19,11 L21,11 L21,15 L19,15 Z M6,10 L6,16 L9,16 L9,10 Z"
                      Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.8" Width="20" Height="20"
                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Name="TitleText" Text="电量提醒" FontSize="13.5" FontWeight="SemiBold" />
                <TextBlock x:Name="BodyText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{DynamicResource TextDimBrush}" />
                <TextBlock Text="点击查看电量页" FontSize="11" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextMuteBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
