<UserControl x:Class="WinToolbox.Views.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="搜索" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Width="230" Height="34"
                         TextChanged="SearchBox_TextChanged" />
                <CheckBox x:Name="AutoRefresh" Style="{StaticResource Chk}" Content="自动刷新" IsChecked="True"
                          Margin="16,0,0,0" VerticalAlignment="Center" Click="AutoRefresh_Click" />
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="80" Height="3" Margin="14,0,0,0"
                             VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="打开文件位置" Style="{StaticResource BtnGhost}" Click="OpenLocation_Click" />
                <Button Content="复制信息" Style="{StaticResource BtnGhost}" Click="Copy_Click" />
                <Button Content="刷新" Style="{StaticResource Btn}" Margin="4,0,8,0" Click="Refresh_Click" />
                <Button Content="结束进程" Style="{StaticResource BtnDanger}" Click="Kill_Click" />
            </StackPanel>
        </Grid>

        <!-- 列表 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <DataGrid x:Name="ProcGrid" Style="{StaticResource Grid}" RowStyle="{StaticResource GridRow}"
                      MouseDoubleClick="ProcGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="进程名称" Binding="{Binding Name}" Width="210" SortMemberPath="Name" />
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="72" SortMemberPath="Pid">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CPU %" Binding="{Binding Cpu, StringFormat={}{0:0.0}}" Width="78"
                                        SortMemberPath="Cpu">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="内存" Binding="{Binding MemMb, StringFormat={}{0:0.0} MB}" Width="96"
                                        SortMemberPath="MemMb">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="线程" Binding="{Binding Threads}" Width="62" SortMemberPath="Threads">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="句柄" Binding="{Binding Handles}" Width="72" SortMemberPath="Handles">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="启动时间" Binding="{Binding StartedText}" Width="96" SortMemberPath="Started" />
                    <DataGridTextColumn Header="公司" Binding="{Binding Company}" Width="170" SortMemberPath="Company" />
                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" SortMemberPath="Path" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部 -->
        <Grid Grid.Row="2" Margin="2,10,2,0">
            <TextBlock x:Name="FooterText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBlock x:Name="SelectedText" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
