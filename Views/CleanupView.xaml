<UserControl x:Class="WinToolbox.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 清理项 -->
        <DataTemplate x:Key="CleanRow">
            <Border Margin="0,0,0,8" Padding="14,11" CornerRadius="9"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Style="{StaticResource Chk}" IsChecked="{Binding Selected, Mode=TwoWay}"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                            <Border Style="{StaticResource Tag}" Background="#FFFFF4E5" Margin="8,0,0,0"
                                    Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="需管理员" FontSize="10.5" Foreground="{DynamicResource WarnBrush}" />
                            </Border>
                            <Border Style="{StaticResource Tag}" Background="#FFFDECEA" Margin="8,0,0,0"
                                    Visibility="{Binding Risk, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="谨慎" FontSize="10.5" Foreground="{DynamicResource DangerBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Path}" FontSize="10.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMuteBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding CountText}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextMuteBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 启动项 -->
        <DataTemplate x:Key="StartupRow">
            <Border Margin="0,0,0,8" Padding="14,11" CornerRadius="9"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" MouseLeftButtonDown="StartupRow_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Style="{StaticResource Chk}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                              VerticalAlignment="Center" ToolTip="勾选 = 启用，取消勾选 = 禁用" />

                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                            <Border Style="{StaticResource Tag}" Background="#FFFFF4E5" Margin="8,0,0,0"
                                    Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="需管理员" FontSize="10.5" Foreground="{DynamicResource WarnBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Command}" FontSize="11.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Source}" FontSize="10.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMuteBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDimBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具条 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="SelectAll" Style="{StaticResource Chk}" Content="全选" VerticalAlignment="Center"
                          Click="SelectAll_Click" IsChecked="True" />
                <TextBlock x:Name="SummaryText" Text="尚未扫描" Margin="18,0,0,0" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" />
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="90" Height="3" Margin="14,0,0,0"
                             VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ScanBtn" Content="扫描占用" Style="{StaticResource Btn}" Margin="0,0,8,0"
                        Click="Scan_Click" />
                <Button x:Name="CleanBtn" Content="清理选中项" Style="{StaticResource BtnPrimary}" Click="Clean_Click" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Style="{StaticResource Tabs}">

            <!-- ============ 清理 ============ -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="临时文件与缓存" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 快捷操作 -->
                    <Border Grid.Row="0" Style="{StaticResource Toolbar}" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="快捷操作：" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <Button Content="刷新 DNS 缓存" Style="{StaticResource BtnGhost}" Click="FlushDns_Click" />
                            <Button Content="打开临时目录" Style="{StaticResource BtnGhost}" Click="OpenTemp_Click" />
                            <Button Content="打开回收站" Style="{StaticResource BtnGhost}" Click="OpenRecycle_Click" />
                            <TextBlock x:Name="QuickStatus" Text="" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <ItemsControl x:Name="CleanList" ItemTemplate="{StaticResource CleanRow}" />
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ 启动项 ============ -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="开机启动项" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Toolbar}" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="取消勾选即可禁用；再次勾选可恢复（注册表项会备份到 HKCU\Software\WinToolbox）。"
                                           Style="{StaticResource Caption}" />
                                <TextBlock x:Name="StartupSummary" Text="" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextMuteBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="打开启动文件夹" Style="{StaticResource BtnGhost}" Click="OpenStartupFolder_Click" />
                                <Button Content="系统启动设置" Style="{StaticResource BtnGhost}" Click="OpenStartupSettings_Click" />
                                <Button Content="刷新" Style="{StaticResource Btn}" Click="RefreshStartup_Click" Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <ItemsControl x:Name="StartupList" ItemTemplate="{StaticResource StartupRow}" />
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
