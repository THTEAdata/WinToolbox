<UserControl x:Class="WinToolbox.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <!-- 外观 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource H2}" />
                    <TextBlock Text="选择界面主题。选「跟随系统」时，会随 Windows 的浅色/深色设置自动切换。"
                               Style="{StaticResource Caption}" Margin="0,6,0,16" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LightBtn" Content="浅色" Style="{StaticResource Btn}" Width="120" Height="38"
                                Margin="0,0,10,0" Click="Light_Click" />
                        <Button x:Name="DarkBtn" Content="深色" Style="{StaticResource Btn}" Width="120" Height="38"
                                Margin="0,0,10,0" Click="Dark_Click" />
                        <Button x:Name="SystemBtn" Content="跟随系统" Style="{StaticResource Btn}" Width="120" Height="38"
                                Click="System_Click" />
                    </StackPanel>

                    <TextBlock x:Name="CurrentText" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <!-- 启动与权限 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="启动与权限" Style="{StaticResource H2}" />
                    <TextBlock Text="控制 WinToolbox 如何随系统启动，以及是否需要管理员权限。"
                               Style="{StaticResource Caption}" Margin="0,6,0,16" TextWrapping="Wrap" />

                    <CheckBox x:Name="AutoStartChk" Style="{StaticResource Chk}"
                              Content="开机时自动启动 WinToolbox（当前用户登录后）"
                              Click="AutoStart_Click" />
                    <TextBlock x:Name="AutoStartPath" Style="{StaticResource Caption}"
                               Margin="26,6,0,0" TextWrapping="Wrap" />

                    <CheckBox x:Name="AdminChk" Style="{StaticResource Chk}" Margin="0,16,0,0"
                              Content="启动时请求管理员权限（会弹 UAC 确认框）"
                              Click="Admin_Click" />
                    <TextBlock Style="{StaticResource Caption}" Margin="26,6,0,0" TextWrapping="Wrap"
                               Text="开启后每次启动都会弹一次 UAC；若同时开启开机自启动，登录时会先出现 UAC 确认。取消 UAC 则照常以普通权限运行。" />

                    <TextBlock x:Name="AdminStateText" Style="{StaticResource Caption}" Margin="0,14,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 电量监控 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="电量监控" Style="{StaticResource H2}" />
                    <TextBlock Text="定时读取外设电池（目前支持雷蛇 HID 协议），低电量时弹窗提醒。"
                               Style="{StaticResource Caption}" Margin="0,6,0,16" TextWrapping="Wrap" />

                    <CheckBox x:Name="MonitorChk" Style="{StaticResource Chk}"
                              Content="定时检查外设电量" Click="Monitor_Click" />

                    <StackPanel Orientation="Horizontal" Margin="26,12,0,0">
                        <TextBlock Text="检查间隔" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <ComboBox x:Name="IntervalBox" Width="130" Margin="12,0,0,0"
                                  SelectionChanged="Interval_Changed">
                            <ComboBoxItem Content="1 分钟" Tag="1" />
                            <ComboBoxItem Content="5 分钟" Tag="5" />
                            <ComboBoxItem Content="10 分钟" Tag="10" />
                            <ComboBoxItem Content="15 分钟" Tag="15" />
                            <ComboBoxItem Content="30 分钟" Tag="30" />
                        </ComboBox>
                    </StackPanel>

                    <CheckBox x:Name="AlertChk" Style="{StaticResource Chk}" Margin="0,16,0,0"
                              Content="低于阈值时弹窗提醒" Click="Alert_Click" />

                    <StackPanel Orientation="Horizontal" Margin="26,12,0,0">
                        <TextBlock Text="提醒阈值" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThresholdBox" Width="130" Margin="12,0,0,0"
                                  SelectionChanged="Threshold_Changed">
                            <ComboBoxItem Content="10%" Tag="10" />
                            <ComboBoxItem Content="20%" Tag="20" />
                            <ComboBoxItem Content="30%" Tag="30" />
                            <ComboBoxItem Content="40%" Tag="40" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="立即检查一次" Style="{StaticResource Btn}" Click="CheckNow_Click" />
                        <TextBlock x:Name="LastCheckText" Style="{StaticResource Caption}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource H2}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="程序版本" Style="{StaticResource Caption}" Margin="0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText" Margin="0,4" />

                        <TextBlock Grid.Row="1" Text="运行环境" Style="{StaticResource Caption}" Margin="0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RuntimeText" Margin="0,4" />

                        <TextBlock Grid.Row="2" Text="程序目录" Style="{StaticResource Caption}" Margin="0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PathText" Margin="0,4"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="3" Text="配置文件" Style="{StaticResource Caption}" Margin="0,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SettingsText" Margin="0,4"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="打开程序目录" Style="{StaticResource Btn}" Margin="0,0,8,0"
                                Click="OpenAppFolder_Click" />
                        <Button Content="打开配置目录" Style="{StaticResource Btn}" Margin="0,0,8,0"
                                Click="OpenSettingsFolder_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
