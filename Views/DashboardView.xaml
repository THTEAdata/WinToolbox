<UserControl x:Class="WinToolbox.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="172" />
            <RowDefinition Height="14" />
            <RowDefinition Height="184" />
            <RowDefinition Height="14" />
            <RowDefinition Height="124" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 系统状态 -->
        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Tile}"
                Margin="0,0,7,0" Click="GoSys_Click">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock Text="系统状态" Style="{StaticResource TileTitle}" />
                    <TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource TileSub}"
                               HorizontalAlignment="Right" />
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- CPU -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CPU" Style="{StaticResource TileSub}" VerticalAlignment="Center" />
                        <ProgressBar x:Name="CpuBar" Grid.Column="1" Height="8" Maximum="100" Margin="0,0,12,0"
                                     VerticalAlignment="Center" />
                        <TextBlock x:Name="CpuText" Grid.Column="2" Text="—" Style="{StaticResource TileSub}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 内存 -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="内存" Style="{StaticResource TileSub}" VerticalAlignment="Center" />
                        <ProgressBar x:Name="MemBar" Grid.Column="1" Height="8" Maximum="100" Margin="0,0,12,0"
                                     VerticalAlignment="Center" />
                        <TextBlock x:Name="MemText" Grid.Column="2" Text="—" Style="{StaticResource TileSub}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="TopProcText" Grid.Row="2" Style="{StaticResource TileSub}" Margin="0,12,0,0"
                               VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Button>

        <!-- 本机概要 -->
        <Button Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource Tile}"
                Margin="7,0,0,0" Click="GoSys_Click">
            <StackPanel>
                <TextBlock Text="本机概要" Style="{StaticResource TileTitle}" />
                <TextBlock x:Name="OsText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CpuModelText" Style="{StaticResource TileSub}" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="GpuText" Style="{StaticResource TileSub}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="BoardText" Style="{StaticResource TileSub}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>

        <!-- 磁盘 -->
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Tile}"
                Margin="0,0,7,0" Click="GoClean_Click">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="磁盘空间" Style="{StaticResource TileTitle}" />
                    <TextBlock x:Name="DiskFreeText" Style="{StaticResource TileSub}" HorizontalAlignment="Right" />
                </DockPanel>
                <StackPanel x:Name="DiskPanel" Grid.Row="1" Margin="0,12,0,0" />
                <TextBlock Grid.Row="2" Text="点击进入系统清理" Style="{StaticResource TileSub}"
                           Margin="0,8,0,0" Foreground="{DynamicResource TextMuteBrush}" />
            </Grid>
        </Button>

        <!-- 网络 -->
        <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource Tile}"
                Margin="7,0,0,0" Click="GoNetwork_Click">
            <StackPanel>
                <TextBlock Text="网络" Style="{StaticResource TileTitle}" />
                <TextBlock x:Name="NetNameText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NetIpText" Style="{StaticResource TileSub}" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NetDnsText" Style="{StaticResource TileSub}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="点击进入网络诊断" Style="{StaticResource TileSub}" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextMuteBrush}" />
            </StackPanel>
        </Button>

        <!-- 进程 -->
        <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource Tile}" Margin="0,0,7,0"
                Click="GoProcess_Click">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="进程" Style="{StaticResource TileTitle}" />
                <TextBlock x:Name="ProcCountText" Text="—" Style="{StaticResource TileValue}" Margin="0,6,0,0" />
                <TextBlock Text="个正在运行" Style="{StaticResource TileSub}" Margin="0,2,0,0" />
            </StackPanel>
        </Button>

        <!-- 服务 -->
        <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource Tile}" Margin="7,0,0,0"
                Click="GoService_Click">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="服务" Style="{StaticResource TileTitle}" />
                <TextBlock x:Name="ServiceCountText" Text="—" Style="{StaticResource TileValue}" Margin="0,6,0,0" />
                <TextBlock Text="个运行中" Style="{StaticResource TileSub}" Margin="0,2,0,0" />
            </StackPanel>
        </Button>

        <!-- USB -->
        <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource Tile}" Margin="7,0,0,0"
                Click="GoUsb_Click">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="USB 设备" Style="{StaticResource TileTitle}" />
                <TextBlock x:Name="UsbCountText" Text="—" Style="{StaticResource TileValue}" Margin="0,6,0,0" />
                <TextBlock Text="个已连接" Style="{StaticResource TileSub}" Margin="0,2,0,0" />
            </StackPanel>
        </Button>

        <!-- 设置 -->
        <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource Tile}" Margin="7,0,0,0"
                Click="GoSettings_Click">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="设置" Style="{StaticResource TileTitle}" />
                <TextBlock Text="主题" Style="{StaticResource TileValue}" Margin="0,6,0,0" />
                <TextBlock x:Name="ThemeText" Text="—" Style="{StaticResource TileSub}" Margin="0,2,0,0" />
            </StackPanel>
        </Button>

        <!-- 快捷操作 -->
        <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource Card}"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="快捷操作" Style="{StaticResource TileTitle}" />
                    <TextBlock Text="常用动作一键完成" Style="{StaticResource TileSub}" Margin="0,4,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="刷新 DNS 缓存" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="FlushDns_Click" />
                    <Button Content="打开临时目录" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="OpenTemp_Click" />
                    <Button Content="打开 UsbTreeView" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="OpenUsbTreeView_Click" />
                    <Button Content="设备管理器" Style="{StaticResource Btn}" Click="OpenDeviceManager_Click" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
