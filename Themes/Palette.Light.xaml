<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色（Windows 11 Fluent / 云母） -->
    <Color x:Key="C.Bg">#FFF3F5F9</Color>
    <Color x:Key="C.Sidebar">#F2F6F9FC</Color>
    <Color x:Key="C.Surface">#F7FFFFFF</Color>
    <Color x:Key="C.Surface2">#FFFFFFFF</Color>
    <Color x:Key="C.Surface3">#FFF4F7FB</Color>
    <Color x:Key="C.Border">#FFE3E7EE</Color>
    <Color x:Key="C.BorderLight">#FFD3D9E2</Color>
    <Color x:Key="C.Text">#FF1B1B1B</Color>
    <Color x:Key="C.TextDim">#FF5C6470</Color>
    <Color x:Key="C.TextMute">#FF8A919C</Color>
    <Color x:Key="C.Accent">#FF0067C0</Color>
    <Color x:Key="C.AccentHover">#FF1975C5</Color>
    <Color x:Key="C.AccentPressed">#FF005BA1</Color>
    <Color x:Key="C.AccentDim">#FFE5F0FA</Color>
    <Color x:Key="C.Success">#FF0F7B0F</Color>
    <Color x:Key="C.Danger">#FFC42B1C</Color>
    <Color x:Key="C.Warn">#FF9D5D00</Color>
    <Color x:Key="C.SuccessSurface">#FFE6F4E6</Color>
    <Color x:Key="C.DangerSurface">#FFFDF3F2</Color>
    <Color x:Key="C.DangerBorder">#FFF0D6D2</Color>
    <Color x:Key="C.WarnSurface">#FFFFF4E5</Color>
    <Color x:Key="C.ScrollThumb">#FFC9CED6</Color>
    <Color x:Key="C.ScrollThumbHover">#FFAEB6C0</Color>
    <Color x:Key="C.RowAlt">#FFFAFBFD</Color>
    <Color x:Key="C.HoverSoft">#FFEEF4FB</Color>
    <Color x:Key="C.ControlHover">#FFF4F7FB</Color>
    <Color x:Key="C.ControlPressed">#FFE7EDF6</Color>
    <Color x:Key="C.InputHoverBorder">#FFB7BFCB</Color>
    <Color x:Key="C.Track">#FFE8ECF2</Color>
    <Color x:Key="C.MenuHover">#FFEDF2F9</Color>
    <Color x:Key="C.ConsoleBg">#FFF8FAFD</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource C.Sidebar}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource C.Surface2}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource C.Surface3}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource C.BorderLight}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource C.TextDim}" />
    <SolidColorBrush x:Key="TextMuteBrush" Color="{StaticResource C.TextMute}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource C.AccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource C.AccentPressed}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource C.AccentDim}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource C.Success}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource C.SuccessSurface}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource C.DangerSurface}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource C.DangerBorder}" />
    <SolidColorBrush x:Key="WarnSurfaceBrush" Color="{StaticResource C.WarnSurface}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource C.ScrollThumb}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource C.ScrollThumbHover}" />
    <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource C.RowAlt}" />
    <SolidColorBrush x:Key="HoverSoftBrush" Color="{StaticResource C.HoverSoft}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource C.ControlHover}" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource C.ControlPressed}" />
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{StaticResource C.InputHoverBorder}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource C.Track}" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="{StaticResource C.MenuHover}" />
    <SolidColorBrush x:Key="ConsoleBgBrush" Color="{StaticResource C.ConsoleBg}" />

    <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF7F9FC" Offset="0" />
        <GradientStop Color="#FFEFF3F9" Offset="0.55" />
        <GradientStop Color="#FFEAF0F8" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="26" ShadowDepth="2" Direction="270"
                      Opacity="0.10" Color="#FF5A6A80" />

    <!-- 玻璃 / 磁贴 / 流动背景 -->
    <Color x:Key="C.CardGlass">#B8FFFFFF</Color>
    <Color x:Key="C.CardGlassHover">#D9FFFFFF</Color>
    <Color x:Key="C.GlassBorder">#A6FFFFFF</Color>
    <Color x:Key="C.GlassHighlight">#CCFFFFFF</Color>
    <Color x:Key="C.Rail">#99FFFFFF</Color>
    <Color x:Key="C.Blob1">#9986C5FF</Color>
    <Color x:Key="C.Blob2">#8A8BE8D8</Color>
    <Color x:Key="C.Blob3">#8AB9A7FF</Color>
    <SolidColorBrush x:Key="CardGlassBrush" Color="{StaticResource C.CardGlass}" />
    <SolidColorBrush x:Key="CardGlassHoverBrush" Color="{StaticResource C.CardGlassHover}" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource C.GlassBorder}" />
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="{StaticResource C.GlassHighlight}" />
    <SolidColorBrush x:Key="RailBrush" Color="{StaticResource C.Rail}" />
    <SolidColorBrush x:Key="Blob1Brush" Color="{StaticResource C.Blob1}" />
    <SolidColorBrush x:Key="Blob2Brush" Color="{StaticResource C.Blob2}" />
    <SolidColorBrush x:Key="Blob3Brush" Color="{StaticResource C.Blob3}" />
</ResourceDictionary>
